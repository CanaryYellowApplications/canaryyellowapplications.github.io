rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All promo-service data is server-only. Public redemption and authenticated
    // administration both go through Cloud Functions, where authorization,
    // validation, rate limits, and atomic writes are enforced.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
